# SAIS Store - variables d'environnement Supabase
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# .env.local est ignore par Git : ne committez jamais de vraie cle.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Admin (facultatif) : email du compte autorise a devenir le premier admin.
# L'admin est cree manuellement (voir docs/DEPLOYMENT.md) ; aucun mot de passe
# ne doit etre stocke ici.
ADMIN_BOOTSTRAP_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000