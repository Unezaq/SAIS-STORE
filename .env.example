# ========================================================================
# SAIS STORE — Environment Variables Template
# Copy this file to .env.local and fill with your new Supabase project values
# NEVER commit .env.local to version control
# ========================================================================

# ------------------------------------------------------------------------
# 1. SUPABASE — Public Variables (Safe for Browser)
# ------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# ------------------------------------------------------------------------
# 2. SUPABASE — Private Variables (SERVER ONLY — Never expose to browser)
# ------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------
# 3. STOREFRONT & CONTACT CONFIGURATION
# ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_PHONE=212644816544

# ------------------------------------------------------------------------
# 4. INITIAL ADMIN BOOTSTRAP (Optional for initial setup)
# ------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@sais.ma
